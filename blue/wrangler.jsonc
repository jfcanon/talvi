{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talvi-blue",
  "main": "worker-wrapper.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
